if(NOT EXISTS "${EXE}")
  message(FATAL_ERROR "Missing executable: ${EXE}")
endif()
# A fresh path containing spaces exercises relocation without companion files.
string(RANDOM LENGTH 12 ALPHABET abcdef0123456789 run_id)
set(isolated "${ROOT}/standalone ${run_id}")
file(MAKE_DIRECTORY "${isolated}")
file(COPY_FILE "${EXE}" "${isolated}/ZCodePet.exe")
file(GLOB files "${isolated}/*")
list(LENGTH files count)
if(NOT count EQUAL 1)
  message(FATAL_ERROR "Standalone directory must contain exactly one executable")
endif()
foreach(test IN ITEMS embedded-assets spine-model spine-lifecycle)
  execute_process(COMMAND "${isolated}/ZCodePet.exe" "--${test}-test"
    WORKING_DIRECTORY "${isolated}" RESULT_VARIABLE result TIMEOUT 30)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Relocated ${test} failed: ${result}")
  endif()
endforeach()
