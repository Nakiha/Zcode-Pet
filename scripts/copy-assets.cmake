# Refresh only the build target's private asset directory, including removal
# of files left by previous versions. Never remove the source asset tree.
foreach(required SOURCE_ASSETS TARGET_ASSETS BINARY_ROOT)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "Missing ${required}")
  endif()
endforeach()
file(REAL_PATH "${SOURCE_ASSETS}" source)
file(REAL_PATH "${TARGET_ASSETS}" destination)
file(REAL_PATH "${BINARY_ROOT}" binaryRoot)
string(TOLOWER "${source}" sourceKey)
string(TOLOWER "${destination}" destinationKey)
string(TOLOWER "${binaryRoot}" binaryKey)
cmake_path(IS_PREFIX binaryKey "${destinationKey}" NORMALIZE inside)
if(NOT inside OR destinationKey STREQUAL sourceKey OR destinationKey STREQUAL binaryKey)
  message(FATAL_ERROR "Unsafe build asset destination: ${destination}")
endif()
foreach(required spine/remilia.json spine/leimi.atlas spine/leimi.png app-icon.ico)
  if(NOT EXISTS "${source}/${required}")
    message(FATAL_ERROR "Missing source asset: ${required}")
  endif()
endforeach()
message(STATUS "Refreshing build assets: ${destination}")
file(REMOVE_RECURSE "${destination}")
file(COPY "${source}/" DESTINATION "${destination}")
