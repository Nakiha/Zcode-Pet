#include "@CMAKE_CURRENT_SOURCE_DIR@/src/resource.h"
#include <windows.h>
IDI_ZCODEPET ICON "@CMAKE_CURRENT_SOURCE_DIR@/assets/app-icon.ico"
IDR_PET_JSON RCDATA "@CMAKE_CURRENT_SOURCE_DIR@/assets/spine/remilia.json"
IDR_PET_ATLAS RCDATA "@CMAKE_CURRENT_SOURCE_DIR@/assets/spine/leimi.atlas"
IDR_PET_PNG RCDATA "@CMAKE_CURRENT_SOURCE_DIR@/assets/spine/leimi.png"
IDR_SPINE_LICENSE RCDATA "@CMAKE_CURRENT_SOURCE_DIR@/third_party/spine-cpp/LICENSE"
IDR_JSON_LICENSE RCDATA "@CMAKE_CURRENT_SOURCE_DIR@/third_party/json.LICENSE"
IDR_PET_CREDITS RCDATA "@CMAKE_CURRENT_SOURCE_DIR@/assets/spine/ATTRIBUTION.txt"
IDR_ZSTD_LICENSE RCDATA "@CMAKE_CURRENT_SOURCE_DIR@/third_party/zstd/LICENSE"
IDD_LICENSES DIALOGEX 0,0,420,300
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Licenses and credits"
FONT 10,"Segoe UI"
BEGIN
  EDITTEXT IDC_LICENSE_TEXT,8,8,404,260,ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
  DEFPUSHBUTTON "Close",IDOK,350,277,62,16
END
1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "ZCode Pet\0"
      VALUE "FileVersion", "@PROJECT_VERSION@\0"
      VALUE "ProductName", "ZCode Pet\0"
      VALUE "ProductVersion", "@PROJECT_VERSION@\0"
      VALUE "OriginalFilename", "ZCodePet.exe\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
