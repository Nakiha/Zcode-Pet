#include "@CMAKE_CURRENT_SOURCE_DIR@/src/resource.h"
IDI_ZCODEPET ICON "@CMAKE_CURRENT_SOURCE_DIR@/assets/app-icon.ico"
1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "ZCode Pet\0"
      VALUE "FileVersion", "@PROJECT_VERSION@\0"
      VALUE "ProductName", "ZCode Pet\0"
      VALUE "ProductVersion", "@PROJECT_VERSION@\0"
      VALUE "OriginalFilename", "ZCodePet.exe\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
